# Every setting the app reads is listed here and read through src/config/env.ts.
# Live values live in Vercel (Project → Settings → Environment Variables); never commit real ones.
# Leave DATABASE_URL unset locally to use embedded PGlite at var/pglite
DATABASE_URL=
AUTH_SECRET=generate-with-openssl-rand-base64-33
# Fallback only — live links are built from the request host (src/lib/origin.ts).
# Used by the seed script and tests, which have no request to read.
APP_URL=http://localhost:3000
# smtp needs SMTP_USER + SMTP_PASS; anything else records mail in the `outbox`
# table (readable at /admin/mailroom) instead of sending.
EMAIL_MODE=file            # file | smtp
SMTP_USER=you@gmail.com
SMTP_PASS=gmail-app-password
EMAIL_FROM="Ananya & Arjun <you@gmail.com>"
# The mail server. Leave SMTP_HOST unset to use SMTP_SERVICE (default gmail).
# Another provider (e.g. Resend) is just: SMTP_HOST=smtp.resend.com SMTP_PORT=465
# SMTP_USER=resend SMTP_PASS=<api key>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_SERVICE=gmail
# Most emails in any 24 hours (Gmail allows ~500). 50 are kept for sign-in
# links; past (budget - 50) invites, reminders, stay details and calendar mail
# wait in a queue (see /admin).
EMAIL_DAILY_BUDGET=400
# Most new wedding sites from /start in any hour
NEW_SITES_PER_HOUR=20
# Page tours start by themselves the first time someone opens a page (0 = only from "?")
TOURS_AUTOSTART=1
# Seeded staff logins, comma-separated, in role order:
# admin, couple, committee, committee, couple-of-second-wedding.
# Unset = @example.com placeholders (fine for EMAIL_MODE=file, where magic links
# are written to var/outbox/mail.jsonl instead of being delivered).
SEED_STAFF_EMAILS=
# Optional: AI-assisted column matching in the guest-list import (/committee/import).
# Any OpenAI-compatible endpoint works; defaults are Groq's free tier + gpt-oss-120b.
# Leave AI_API_KEY empty and the import still works with the built-in name-based matcher.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
# Reads photos of handwritten/printed guest lists (needs AI_API_KEY too)
AI_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Optional: Gujarati/Hindi printed cards. Names are spelled out and addresses,
# venues, dress codes and closing lines translated by Azure Translator (free F0
# tier: 2M characters a month). Unset = our built-in spelling rules.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=centralindia
